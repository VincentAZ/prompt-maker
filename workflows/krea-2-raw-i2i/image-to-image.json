{
  "format": "prompt-maker-workflow",
  "name": "Krea 2 RAW: image to image",
  "note": "Changes the picture in step ③. 12 steps with Krea’s turbo LoRA; only ComfyUI’s own nodes.",
  "prompt": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "krea2_raw_fp8_scaled.safetensors",
        "weight_dtype": "default"
      },
      "_meta": {
        "title": "Load Diffusion Model"
      }
    },
    "2": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "71",
          0
        ],
        "vae": [
          "3",
          0
        ]
      },
      "_meta": {
        "title": "VAE Decode"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "qwen_image_vae.safetensors"
      },
      "_meta": {
        "title": "Load VAE"
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": [
          "12",
          0
        ]
      },
      "_meta": {
        "title": "CLIP Text Encode Negative Prompt"
      }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "PromptMaker/krea2_i2i",
        "images": [
          "2",
          0
        ]
      },
      "_meta": {
        "title": "Save Image"
      }
    },
    "12": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen3vl_4b_fp8_scaled.safetensors",
        "type": "krea2",
        "device": "default"
      },
      "_meta": {
        "title": "Load CLIP"
      }
    },
    "38": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "lora_name": "krea2_turbo_lora_rank_64_bf16.safetensors",
        "strength_model": 1,
        "model": [
          "1",
          0
        ]
      },
      "_meta": {
        "title": "Load LoRA (turbo)"
      }
    },
    "45": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": [
          "12",
          0
        ]
      },
      "_meta": {
        "title": "CLIP Text Encode Positive Prompt"
      }
    },
    "66": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "example.png"
      },
      "_meta": {
        "title": "Load Image"
      }
    },
    "69": {
      "class_type": "VAEEncode",
      "inputs": {
        "pixels": [
          "66",
          0
        ],
        "vae": [
          "3",
          0
        ]
      },
      "_meta": {
        "title": "VAE Encode"
      }
    },
    "71": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0,
        "steps": 12,
        "cfg": 1,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 0.8,
        "model": [
          "38",
          0
        ],
        "positive": [
          "45",
          0
        ],
        "negative": [
          "6",
          0
        ],
        "latent_image": [
          "69",
          0
        ]
      },
      "_meta": {
        "title": "KSampler"
      }
    }
  },
  "mapping": {
    "prompt": [
      {
        "node": "45",
        "input": "text"
      }
    ],
    "motion": [],
    "image": {
      "node": "66",
      "input": "image"
    },
    "video": null,
    "width": null,
    "height": null,
    "aspect": null,
    "frames": null,
    "seconds": null,
    "fps": null,
    "seed": [
      {
        "node": "71",
        "input": "seed"
      }
    ]
  },
  "options": {
    "snap": 16,
    "frameRule": "exact",
    "fps": 24,
    "randomizeSeed": true,
    "seedMode": "random"
  },
  "models": [
    {
      "name": "krea2_raw_fp8_scaled.safetensors",
      "url": "https://huggingface.co/Comfy-Org/Krea-2/resolve/main/diffusion_models/krea2_raw_fp8_scaled.safetensors",
